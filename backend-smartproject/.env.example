# Copy to `.env` and fill in values. Restart the backend after edits.

PORT=8080
MONGODB_URI=mongodb://localhost:27017/your-database-name

SESSION_SECRET=change-me-in-production

# Public base URL where the backend is reachable (used for OAuth redirect_uri defaults).
BASE_URL=http://localhost:8080

# Where the SPA runs after OAuth / bypass login.
# - Production (`npm run start`, single server on :8080): use BASE_URL (http://localhost:8080)
# - Vite dev (frontend :5173, API :8080): use http://localhost:5173
FRONTEND_URL=http://localhost:8080

# Google OAuth — omit to disable Google routes until credentials exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# LinkedIn OpenID Connect — omit to disable LinkedIn OAuth until credentials exist.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:8080/api/auth/linkedin/callback
