{
  "name": "backend-smartproject",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "echo 'Backend: no compile step in this project — production runs tsx src/index.ts from source. After git pull, restart the server (pm2/systemd/docker) so new routes load. Optional: npm run compile to emit dist/ and use npm run start:compiled.'",
    "build:force": "echo 'Same as build — use git pull + restart, or npm run compile for dist/'",
    "start": "NODE_ENV=production tsx src/index.ts",
    "start:compiled": "NODE_ENV=production node dist/index.js",
    "compile": "tsc",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:push:remote": "tsx scripts/db-push-remote.ts",
    "db:clone:schema:to-remote": "tsx scripts/db-clone-schema-to-remote.ts",
    "db:fix-duration": "tsx scripts/fix-duration.ts",
    "db:migrate:allocation-version": "tsx scripts/run-allocation-version-migration.ts",
    "auth-health": "tsx scripts/auth-health-check.ts",
    "seed:activities": "tsx scripts/seed-activity-samples.ts",
    "seed:resources": "tsx scripts/seed-resource-samples.ts",
    "seed:workforce": "tsx scripts/seed-workforce-samples.ts",
    "seed:rental-mappings": "tsx scripts/seed-rental-mappings.ts",
    "seed:materials-tools": "tsx scripts/seed-materials-tools-costs.ts",
    "seed:services-vendors": "tsx scripts/seed-services-vendors.ts"
  },
  "dependencies": {
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-linkedin-oauth2": "^1.5.6",
    "backblaze-b2": "^1.7.1",
    "connect-mongodb-session": "^5.0.0",
    "dotenv": "^16.5.0",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "express-session": "^1.18.1",
    "memorystore": "^1.6.7",
    "mongodb": "^7.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-local": "^1.0.0",
    "tsx": "^4.19.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-session": "^1.18.0",
    "@types/mongodb": "^4.0.6",
    "@types/node": "^20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.5.13",
    "typescript": "5.6.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
